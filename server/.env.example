# Server Port (automatically set by hosts like Render/Railway)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas free tier: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/carelink_emergency?retryWrites=true&w=majority)
MONGODB_URI=your_mongodb_connection_string

# Secret key for signing JWT tokens (use a long, secure random string)
JWT_SECRET=your_jwt_secret_key

# Frontend URL(s) allowed by CORS (comma-separated for multiple domains, no trailing slashes)
# Example: https://carelink.vercel.app,https://carelink.netlify.app
CLIENT_URL=http://localhost:5173

# Optional: Initial System Administrator Credentials (created automatically on first boot)
ADMIN_EMAIL=admin@carelink.org
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=System Administrator

# Optional: Local Demo Hospital Accounts Password (for mock/demo hospital login in local development)
DEMO_HOSPITAL_PASSWORD=your_local_demo_password
